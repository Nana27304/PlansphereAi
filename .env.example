# APPLICATION
ENVIRONMENT=development
DEV_SHOW_OTP=true
SECRET_KEY=
ACCESS_TOKEN_MINUTES=720
DATABASE_URL=sqlite:///./plansphere.db
STORAGE_DIR=./storage
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ADVANCED_MODEL=
AI_MAX_OUTPUT_TOKENS=1800
TAVILY_API_KEY=

# EMAIL OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# FLUTTERWAVE — KEEP LIVE PAYMENT FLAGS FALSE UNTIL ONBOARDED/TESTED
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_API_BASE=https://api.flutterwave.com/v3
FLUTTERWAVE_GHS_ENABLED=false
FLUTTERWAVE_USD_ENABLED=false
FLUTTERWAVE_GHS_BANK_TRANSFER_ENABLED=false

# Prices are major currency units; do not enter pesewas/cents.
ADVANCED_PRICE_USD=10.00
ADVANCED_PRICE_GHS=
PROFESSIONAL_PRICE_USD=0.00
PROFESSIONAL_PRICE_GHS=0.00

